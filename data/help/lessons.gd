const W3 := "https://www.w3schools.com/c/"

const LESSONS := [
	{
		"level": 1, "title": "Your First Program", "concept": "Syntax, variables and arithmetic",
		"pages": [
			{"title": "Welcome to the kitchen!",
			"text": "I'm [b]Chef Miso[/b], and I'll teach you C one step at a time.\n\nYour staff can't read minds: they follow a [b]program[/b] that you write in C.\n• Walk up to a staff member and press [b]E[/b] to open their program.\n• Type your code, then press [b]Run[/b]. The staff member follows it line by line.\n• The [b]Output[/b] box shows messages and any mistakes, with the line number.\n• To spend coins, walk to an upgrade spot and press [b]E[/b]: the [b]chalkboard[/b] upgrades the restaurant, a dashed [b]+ Table[/b] spot buys a table, and a table adds a chair.\n\nUntil Level 2, every customer orders [b]Today's Special[/b] (the gold button at the top left; click it to change the dish). Cook that dish and serve() it!",
			"code": "", "w3": "c_intro.php"},
			{"title": "How a C program is built",
			"text": "• [b]main()[/b] is where a C program starts running. Every program needs exactly one.\n• Everything main() does goes between the curly brackets [b]{ }[/b].\n• Each instruction is a [b]statement[/b], and every statement ends with a semicolon [b];[/b]\n• Statements run from [b]top to bottom[/b], one at a time.\n• Spaces, tabs and new lines are only for people: indent the code inside { } so it is easy to read.\n• C is [b]case-sensitive[/b]: Main, MAIN and main are three different names.",
			"code": "void main() {\n    printf(\"Good morning, kitchen!\\n\");\n    printf(\"Doors open at 8.\\n\");\n}", "w3": "c_syntax.php"},
			{"title": "Output with printf",
			"text": "[b]printf()[/b] writes text to the Output box under your code.\n\n• The text goes inside [b]double quotes[/b]: \"like this\".\n• printf does [b]not[/b] start a new line by itself. Put [b]\\n[/b] where you want a line break.\n• You can call printf as many times as you like.\n\nTry it: remove the \\n from the first line and see how the output changes.",
			"code": "void main() {\n    printf(\"Hello!\\n\");\n    printf(\"Let's \");\n    printf(\"cook.\\n\");\n}", "w3": "c_output.php"},
			{"title": "Comments",
			"text": "Comments are notes for people; the computer skips them completely.\n\n• [b]//[/b] makes the rest of the line a comment.\n• [b]/*[/b] starts a comment that can cover several lines, and [b]*/[/b] ends it.\n• Use comments to explain [i]why[/i] code does something.\n• Putting // in front of a line switches it off while you test.",
			"code": "void main() {\n    // Greet the team\n    printf(\"Only this prints\\n\");\n    /* This note can\n       cover several lines */\n    // printf(\"This line is switched off\\n\");\n}", "w3": "c_comments.php"},
			{"title": "Telling staff what to do",
			"text": "Staff move and work through [b]kitchen commands[/b]. You use them exactly like printf(): this is called [b]calling a function[/b].\n\n• Write the command's name, then ( ).\n• A value inside the ( ) is an [b]argument[/b]: it says where or what, like [code]go_to(FRIDGE)[/code].\n• Some commands need no argument: [code]cook()[/code].\n• End each call with ;\n\nLevel 1 commands:\n• [b]go_to(STATION)[/b] walk to a station and face it\n• [b]pick_up(INGREDIENT)[/b] take an ingredient (at the FRIDGE)\n• [b]cook()[/b] cook what you hold (at a GRILL, STOVE...)\n• [b]plate()[/b] put it on your plate (at the ASSEMBLY)\n• [b]assemble(DISH)[/b] turn the plate into a dish\n• [b]serve()[/b] carry the dish to the customer\n• [b]wait(seconds)[/b] and [b]holding()[/b]\n\nYou'll learn to write your [b]own[/b] functions in Lesson 5.",
			"code": "void main() {\n    go_to(FRIDGE);     // argument: where to go\n    pick_up(EGG);      // argument: what to take\n    go_to(GRILL);\n    cook();            // no argument\n    go_to(ASSEMBLY);\n    plate();\n}", "w3": "c_functions.php"},
			{"title": "Variables",
			"text": "A [b]variable[/b] is a container that stores a value so you can use it later.\n\n• Create (declare) one with [b]type name = value;[/b]\n• You can declare first and give a value later: [code]int eggs;[/code] then [code]eggs = 3;[/code]\n• Giving a new value with = replaces the old one.\n• Kitchen names like EGG are numbers, so they fit in an [b]int[/b]: [code]int food = EGG;[/code]",
			"code": "void main() {\n    int served = 0;\n    int food = EGG;\n    go_to(FRIDGE);\n    pick_up(food);\n    served = 1;\n    printf(\"Served: %d\\n\", served);\n}", "w3": "c_variables.php"},
			{"title": "Naming variables",
			"text": "Rules for names:\n• Use letters, digits and underscores _ only: [code]eggs_left[/code]\n• A name can't start with a digit: [code]2eggs[/code] is an error.\n• No spaces: [code]eggs left[/code] is two names.\n• C keywords like int, if or while can't be names.\n• Names are case-sensitive: [code]Eggs[/code] and [code]eggs[/code] are different variables.\n\nGood names say what the value means: [code]coins_today[/code] beats [code]x[/code].",
			"code": "void main() {\n    int coins_today = 0;\n    int eggs_left = 12;\n    printf(\"%d coins, %d eggs\\n\", coins_today, eggs_left);\n}", "w3": "c_variables_names.php"},
			{"title": "Data types and format specifiers",
			"text": "Every variable has a [b]data type[/b] that decides what it holds and how printf shows it:\n\n• [b]int[/b] whole numbers (3, -12), printed with [b]%d[/b]\n• [b]float[/b] decimals (2.5), printed with [b]%f[/b]; [b]%.2f[/b] shows 2 decimals\n• [b]double[/b] more exact decimals, printed with [b]%lf[/b]\n• [b]char[/b] one letter in single quotes ('A'), printed with [b]%c[/b]\n• In the kitchen, [b]%s[/b] prints a kitchen name like GRILL.\n\nPut the values after the text, separated by commas, in the same order as the specifiers.",
			"code": "void main() {\n    int eggs = 2;\n    float price = 30.0;\n    char size = 'L';\n    printf(\"%d eggs, size %c, %.2f coins\\n\", eggs, size, eggs * price);\n    printf(\"Cooking at the %s\\n\", GRILL);\n}", "w3": "c_data_types.php"},
			{"title": "Arithmetic operators",
			"text": "[b]Arithmetic operators[/b] do math:\n• [b]+[/b] add   [b]-[/b] subtract   [b]*[/b] multiply   [b]/[/b] divide\n• [b]%[/b] remainder (modulo): 7 % 3 is 1\n\nImportant details:\n• [b]*  /  %[/b] happen before [b]+  -[/b]. Use ( ) to change the order: (2 + 3) * 4 is 20.\n• Dividing two ints [b]drops the decimals[/b]: 7 / 2 is 3. Use a float to keep them: 7.0 / 2 is 3.5.\n• Dividing by 0 is an error.",
			"code": "void main() {\n    int egsilog = 30;\n    int hotsilog = 40;\n    int total = egsilog * 2 + hotsilog;\n    printf(\"Total: %d coins\\n\", total);\n    printf(\"Split by 3: %d each, %d left over\\n\", total / 3, total % 3);\n    printf(\"Exact share: %.2f\\n\", total / 3.0);\n}", "w3": "c_operators.php"},
			{"title": "Assignment and increment",
			"text": "Shortcuts for changing a variable:\n• [b]x += 5;[/b] means x = x + 5;   also [b]-=  *=  /=  %=[/b]\n• [b]x++;[/b] adds 1   [b]x--;[/b] takes 1 away\n\nThese are perfect for keeping score: coins earned, dishes served, eggs used.",
			"code": "void main() {\n    int coins = 100;\n    int served = 0;\n    coins += 30;    // sold an Egsilog\n    served++;\n    coins -= 10;    // bought ingredients\n    printf(\"%d coins after %d dish\\n\", coins, served);\n}", "w3": "c_operators_assignment.php"},
			{"title": "Common mistakes",
			"text": "When the Output box shows an error, check these first:\n• [b]Missing ;[/b] at the end of a statement.\n• [b]Wrong capitals[/b]: [code]Go_to[/code] or [code]egg[/code] instead of [code]go_to[/code] and [code]EGG[/code].\n• [b]Unclosed { or ([/b]: every opening bracket needs a closing one.\n• [b]Wrong station[/b]: cook() at the FRIDGE, or plate() away from the ASSEMBLY.\n\nThe message names the line and usually suggests the fix (\"Did you mean...?\"). Read it, fix that line, and Run again.",
			"code": "void main() {\n    int eggs = 2;   // ends with ;\n    eggs++;         // C sees eggs and Eggs as different\n    printf(\"%d\\n\", eggs);\n}", "w3": "c_syntax.php"},
			{"title": "Your Level 1 goals and challenges",
			"text": "To upgrade the Tiny Stall you need two things (both listed at the top left):\n• [b]Goals[/b] for the restaurant: make [b]10 Hotsilog[/b], make [b]10 Egsilog[/b], and earn [b]300 profit[/b] at this level.\n• Four [b]challenges[/b] for your code. The game checks your program while it runs, so each one needs real C:\n• [b]Count your sales[/b]: an [b]int[/b] variable that changes ([code]served++;[/code]) printed with [b]%d[/b].\n• [b]Price tag[/b]: a [b]float[/b] variable printed with [b]%.2f[/b] (2 decimals, like money).\n• [b]Size code[/b]: a [b]char[/b] variable (one letter in single quotes, [code]'L'[/code]) printed with [b]%c[/b].\n• [b]Print a receipt[/b]: [b]after serve()[/b], ONE printf that uses all three: %d, %.2f and %c.\n\nEvery challenge also needs a dish served in the same Run. Goals and challenges both pay coins and EXP.",
			"code": "void main() {\n    int served = 0;        // whole number\n    float price = 30.50;   // decimal number\n    char size = 'L';       // one letter\n\n    // ...make and serve the dish here...\n    served++;\n\n    printf(\"Order #%d  Egsilog x1  %.2f  size %c\\n\", served, price, size);\n}", "w3": "c_data_types.php"},
		],
		"practice": {"task": "Finish all four Level 1 challenges in one program: make and serve Today's Special, then count it with an int, print a float price with %.2f, a char size with %c, and finally one receipt line that uses all three.",
			"code": "void main() {\n    int served = 0;\n    float price = 30.50;\n    char size = 'L';\n\n    // Make Today's Special (fetch, cook and plate each ingredient)\n\n    // assemble(...);\n    // serve();\n\n    served++;\n    printf(\"Served: %d\\n\", served);\n    printf(\"Price: %.2f\\n\", price);\n    printf(\"Size: %c\\n\", size);\n    printf(\"Order #%d  ... x1  %.2f  size %c\\n\", served, price, size);\n}"},
