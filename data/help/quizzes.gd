		"why": "%f prints a float; %.2f limits it to 2 decimals, like money."},
	"Arithmetic operators": {"q": "What is 7 / 2 when both are ints?",
		"a": ["3.5", "3", "4"], "ok": 1,
		"why": "Dividing two ints drops the decimals, so 7 / 2 is 3."},
	"Assignment and increment": {"q": "coins is 100. What is it after coins += 30;?",
		"a": ["30", "100", "130"], "ok": 2,
		"why": "coins += 30 means coins = coins + 30."},
