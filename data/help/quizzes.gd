		"a": ["Read the message and fix line 4", "Delete the whole program", "Press Run again and hope"], "ok": 0,
		"why": "The message names the line and usually suggests the fix."},
	"Your Level 1 goals and challenges": {"q": "Which specifier prints a char like 'L'?",
		"a": ["%c", "%s", "%d"], "ok": 0,
		"why": "%c prints one character."},
