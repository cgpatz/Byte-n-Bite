extends RefCounted
## Quick-check questions for Chef Miso's lessons, one per lesson page (keyed
## by the page title in data/help/lessons.gd). Shown under the page in the
## Lessons window; a correct answer earns a star for that lesson.
##
## Quiz: {"q": question, "a": [choices], "ok": index of the right choice, "why": short explanation}

const QUIZ := {
	# --- Lesson 1 -------------------------------------------------------------------
	"Welcome to the kitchen!": {"q": "How do you open a staff member's program?",
		"a": ["Walk up to them and press E", "Press Tab", "Click the coins counter"], "ok": 0,
		"why": "Walk up to a staff member and press E, then type your code and press Run."},
	"How a C program is built": {"q": "Which character ends every C statement?",
		"a": [". (period)", "; (semicolon)", ": (colon)"], "ok": 1,
		"why": "Every statement ends with a semicolon ;"},
	"Output with printf": {"q": "What makes printf start a new line?",
		"a": ["\\n", "/n", "Nothing, it always does"], "ok": 0,
		"why": "printf never adds a line break by itself; \\n adds one."},
	"Comments": {"q": "What does the computer do with a // comment?",
		"a": ["Prints it", "Skips it completely", "Runs it twice"], "ok": 1,
		"why": "Comments are notes for people; the computer ignores them."},
	"Telling staff what to do": {"q": "In go_to(FRIDGE), what is FRIDGE?",
		"a": ["A comment", "An argument", "A variable type"], "ok": 1,
		"why": "The value inside the ( ) is an argument: it tells the function where to go."},
	"Variables": {"q": "Which line declares a variable correctly?",
		"a": ["eggs int = 3;", "int eggs = 3;", "int = eggs 3;"], "ok": 1,
		"why": "The pattern is type name = value;"},
